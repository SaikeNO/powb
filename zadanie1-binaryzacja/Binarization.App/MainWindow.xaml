<Window x:Class="Binarization.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Binarization" Width="1000" Height="720"
        MinWidth="600" MinHeight="400" Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Otwórz obraz…" Click="Open_Click" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Obraz testowy" Click="Sample_Click" Padding="8,4" Margin="0,0,8,0"/>
                <TextBlock x:Name="FileLabel" Text="Obraz testowy" VerticalAlignment="Center"/>
            </WrapPanel>
            <WrapPanel>
                <StackPanel Width="180" Margin="0,0,8,8">
                    <TextBlock>Próg: <Run Text="{Binding ElementName=ThresholdSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}}"/></TextBlock>
                    <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="128" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Settings_Changed"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,8">
                    <TextBlock>Okno: <Run Text="{Binding ElementName=WindowSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}}"/></TextBlock>
                    <Slider x:Name="WindowSlider" Minimum="3" Maximum="101" Value="25" IsSnapToTickEnabled="True" TickFrequency="2" ValueChanged="Settings_Changed"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,8">
                    <TextBlock>Niblack k: <Run Text="{Binding ElementName=NiblackSlider, Path=Value, Mode=OneWay, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider x:Name="NiblackSlider" Minimum="-1" Maximum="0.5" Value="-0.2" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Settings_Changed"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,8">
                    <TextBlock>Sauvola k: <Run Text="{Binding ElementName=SauvolaSlider, Path=Value, Mode=OneWay, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider x:Name="SauvolaSlider" Minimum="0" Maximum="1" Value="0.5" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Settings_Changed"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,8">
                    <TextBlock>Phansalkar k: <Run Text="{Binding ElementName=PhansalkarSlider, Path=Value, Mode=OneWay, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider x:Name="PhansalkarSlider" Minimum="0" Maximum="1" Value="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="Settings_Changed"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <UniformGrid Columns="3">
                <StackPanel Margin="4"><TextBlock Text="Oryginał (skala szarości)"/><Image x:Name="OriginalPreview"/></StackPanel>
                <StackPanel Margin="4"><TextBlock x:Name="ThresholdCaption" Text="Progowa"/><Image x:Name="ThresholdPreview"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="Niblack"/><Image x:Name="NiblackPreview"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="Sauvola"/><Image x:Name="SauvolaPreview"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="Phansalkar"/><Image x:Name="PhansalkarPreview"/></StackPanel>
                <StackPanel Margin="4"><TextBlock x:Name="OtsuCaption" Text="Otsu"/><Image x:Name="OtsuPreview"/></StackPanel>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Window>
