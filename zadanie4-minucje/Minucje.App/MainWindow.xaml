<Window x:Class="Minucje.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minucje — Crossing Number" Height="760" Width="1240" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="#F3F4F6">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- przełącznik widoku: trzy przyciski obok siebie, zaznaczony podświetlony -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="GroupName" Value="View"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Padding="12,4" Margin="-1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- wiersz tabeli (Models/TableRow): checkbox + ikona | nazwa | CN | A | B -->
        <DataTemplate x:Key="CountRowTemplate">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5"
                    ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ShowCheck" Tag="{Binding VisibilityKey}" IsChecked="{Binding IsVisible, Mode=OneWay}"
                                  Checked="Visibility_Changed" Unchecked="Visibility_Changed" VerticalAlignment="Center" Margin="0,0,4,0"
                                  ToolTip="Pokaż na obrazach"/>
                        <Image Source="{Binding Icon}" Width="16" Height="16"/>
                    </StackPanel>
                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CrossingNumber}" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="AText" Grid.Column="3" Text="{Binding CountAText}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BText" Grid.Column="4" Text="{Binding CountBText}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasCheckBox}" Value="False">
                    <Setter TargetName="ShowCheck" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="AText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="BText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- pasek widoku -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Widok" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
            <RadioButton x:Name="ViewOriginal" Content="Oryginał" Style="{StaticResource Segment}"
                         IsChecked="True" Checked="View_Changed"/>
            <RadioButton x:Name="ViewSkeleton" Content="Szkielet" Style="{StaticResource Segment}"
                         Checked="View_Changed"/>
            <RadioButton x:Name="ViewBinary" Content="Binarny" Style="{StaticResource Segment}"
                         Checked="View_Changed"/>
        </StackPanel>

        <!-- odcisk A -->
        <Border x:Name="PanelA" Tag="A" Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" AllowDrop="True"
                DragEnter="Panel_DragEnter" DragLeave="Panel_DragLeave" Drop="Panel_Drop">
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="A" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Content="Otwórz…" ToolTip="Wczytaj własny obraz (PNG, JPG, BMP, TIFF) albo przeciągnij go na panel" Click="Open_Click" Tag="A"/>
                    <ComboBox x:Name="SampleComboA" Tag="A" DisplayMemberPath="Name" Margin="0,0,8,0"
                              SelectionChanged="Sample_Changed" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Zapisz…" ToolTip="Zapisz obraz z zaznaczonymi minucjami jako PNG" Click="Save_Click" Tag="A"/>
                    <TextBlock x:Name="InfoA" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Image x:Name="ImageA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </DockPanel>
        </Border>

        <!-- odcisk B -->
        <Border x:Name="PanelB" Tag="B" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" AllowDrop="True"
                DragEnter="Panel_DragEnter" DragLeave="Panel_DragLeave" Drop="Panel_Drop">
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="B" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Content="Otwórz…" ToolTip="Wczytaj własny obraz (PNG, JPG, BMP, TIFF) albo przeciągnij go na panel" Click="Open_Click" Tag="B"/>
                    <ComboBox x:Name="SampleComboB" Tag="B" DisplayMemberPath="Name" Margin="0,0,8,0"
                              SelectionChanged="Sample_Changed" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Zapisz…" ToolTip="Zapisz obraz z zaznaczonymi minucjami jako PNG" Click="Save_Click" Tag="B"/>
                    <TextBlock x:Name="InfoB" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Image x:Name="ImageB" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </DockPanel>
        </Border>

        <!-- panel boczny: liczba minucji i filtr -->
        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12">
                    <TextBlock Text="Liczba minucji" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pokaż" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="1" Text="Typ" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="2" Text="CN" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="A" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="B" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl x:Name="MinutiaCountsList" ItemTemplate="{StaticResource CountRowTemplate}"/>

                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,18,0,14"/>

                    <TextBlock Text="Fałszywe minucje" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="RemoveFalseMinutiaeCheck" Content="Usuwaj fałszywe minucje" IsChecked="True"
                              Click="Options_Changed" Margin="0,0,0,10"/>

                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=RemoveFalseMinutiaeCheck}">
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock x:Name="BorderMarginText" DockPanel.Dock="Right" Text="16 px" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Margines brzegu"
                                       ToolTip="Minucje bliżej brzegu odcisku niż ta odległość są odrzucane."/>
                        </DockPanel>
                        <Slider x:Name="BorderMarginSlider" Minimum="0" Maximum="40" Value="16" IsSnapToTickEnabled="True"
                                TickFrequency="1" ValueChanged="Slider_Changed" Margin="0,0,0,8"/>

                        <DockPanel Margin="0,0,0,2">
                            <TextBlock x:Name="MinDistanceText" DockPanel.Dock="Right" Text="8 px" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Minimalna odległość"
                                       ToolTip="Dwie minucje bliżej siebie niż ta odległość są uznawane za szum i odrzucane."/>
                        </DockPanel>
                        <Slider x:Name="MinDistanceSlider" Minimum="0" Maximum="20" Value="8" IsSnapToTickEnabled="True"
                                TickFrequency="1" ValueChanged="Slider_Changed" Margin="0,0,0,8"/>

                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pokaż" Style="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="Przyczyna odrzucenia" Style="{StaticResource Muted}"/>
                        </Grid>

                        <ItemsControl x:Name="RejectedCountsList" ItemTemplate="{StaticResource CountRowTemplate}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Image x:Name="RejectedLegendIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="odrzucona" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                        <Border Width="14" Height="14" Background="#F0E4BA" Margin="0,0,6,0"/>
                        <TextBlock Text="poza odciskiem" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="5" Margin="2,8,0,0" Style="{StaticResource Muted}"
                   Text="Przeciągnij obraz odcisku na panel A lub B, żeby go wczytać."/>
    </Grid>
</Window>
