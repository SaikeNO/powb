<Window x:Class="Segmentation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segmentation" Width="900" Height="720"
        MinWidth="560" MinHeight="400">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="Otwórz obraz…" Click="Open_Click" HorizontalAlignment="Left" Padding="12,5" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Zakres wartości ±"/><Run Text="{Binding ElementName=ToleranceSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}}"/>
                </TextBlock>
                <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="255" Value="30"
                        IsSnapToTickEnabled="True" TickFrequency="1" Width="250" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Maks. liczba pikseli (0 = bez limitu)" VerticalAlignment="Center" />
                <TextBox x:Name="MaxPixelsInput" Text="0" Width="100" Margin="12,0,0,0" Padding="4" />
            </StackPanel>
            <CheckBox x:Name="GlobalCheck" Content="Tryb globalny" Margin="0,0,0,8" />
            <StackPanel x:Name="MorphControls" IsEnabled="False" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Erozja" Click="Erode_Click" Padding="12,5" Margin="0,0,6,0" />
                <Button Content="Dylatacja" Click="Dilate_Click" Padding="12,5" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Otwórz obraz i kliknij obszar do zaznaczenia."
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="Preview" Stretch="None" Cursor="Cross" MouseLeftButtonDown="Image_Click"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
