<Window x:Class="Szkieletyzacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szkieletyzacja" Height="600" Width="1000">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Otwórz obraz..." Click="Open_Click" Padding="10,4" Margin="0,0,12,0"/>
            <TextBlock Text="Próg:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="128" Width="150"
                    VerticalAlignment="Center" ValueChanged="Threshold_Changed"/>
            <TextBlock x:Name="ThresholdText" Text="128" Width="30" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <CheckBox x:Name="DarkObjectCheck" Content="Obiekt ciemny" IsChecked="True" VerticalAlignment="Center"
                      Margin="0,0,12,0" Click="Threshold_Changed"/>
            <ComboBox x:Name="AlgoCombo" SelectedIndex="0" Width="130" Margin="0,0,8,0">
                <ComboBoxItem Content="Zhang-Suen"/>
                <ComboBoxItem Content="KMM"/>
            </ComboBox>
            <Button Content="Szkieletyzuj" Click="Run_Click" Padding="10,4" Margin="0,0,12,0"/>
            <TextBlock x:Name="TimeText" VerticalAlignment="Center"/>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0">
                <Image x:Name="BinaryImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4,0,0,0">
                <Image x:Name="ResultImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </Grid>
    </Grid>
</Window>
