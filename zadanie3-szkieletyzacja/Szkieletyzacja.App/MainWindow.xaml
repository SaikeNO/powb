<Window x:Class="Szkieletyzacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szkieletyzacja" Height="720" Width="1200" MinWidth="760" MinHeight="480"
        AllowDrop="True" Drop="Window_Drop" Background="#F3F4F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="10,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Obraz testowy:" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SampleCombo" Width="210" Margin="0,0,8,0" DisplayMemberPath="Name"
                          SelectionChanged="Sample_Changed"/>
                <Button Content="Otwórz własny obraz…" Click="Open_Click"/>
                <Button x:Name="SaveButton" Content="Zapisz zaznaczony szkielet…" Click="Save_Click" IsEnabled="False"/>
                <Rectangle Width="1" Fill="#D1D5DB" Margin="4,0,12,0"/>
                <CheckBox x:Name="OverlayCheck" Content="Nakładka na obraz" VerticalAlignment="Center" Margin="0,0,12,0"
                          Click="Overlay_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Próg:" Style="{StaticResource Label}"/>
                <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="128" Width="170"
                        VerticalAlignment="Center" ValueChanged="Threshold_Changed"
                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock x:Name="ThresholdText" Text="128" Width="30" Style="{StaticResource Label}" Margin="6,0,6,0"/>
                <Button Content="Auto (Otsu)" Click="Otsu_Click"/>
                <CheckBox x:Name="DarkObjectCheck" Content="Obiekt ciemny" IsChecked="True" VerticalAlignment="Center"
                          Margin="0,0,16,0" Click="Threshold_Changed"/>
                <Rectangle Width="1" Fill="#D1D5DB" Margin="0,0,12,0"/>
                <TextBlock Text="Powiększenie:" Style="{StaticResource Label}"/>
                <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="8" Value="1" Width="150"
                        VerticalAlignment="Center" ValueChanged="Zoom_Changed"/>
                <TextBlock x:Name="ZoomText" Text="100%" Width="45" Style="{StaticResource Label}" Margin="6,0,6,0"/>
                <Button Content="Dopasuj" Click="Fit_Click"/>
                <Button Content="100%" Click="Zoom100_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Obraz binarny" Style="{StaticResource Caption}"/>
                    <ScrollViewer x:Name="LeftScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="Scroll_Changed" PreviewMouseWheel="Scroll_Wheel">
                        <Image x:Name="BinaryImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock x:Name="ResultCaption" DockPanel.Dock="Top" Text="Szkielet" Style="{StaticResource Caption}"/>
                    <ScrollViewer x:Name="RightScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="Scroll_Changed" PreviewMouseWheel="Scroll_Wheel">
                        <Image x:Name="ResultImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Algorytmy" Style="{StaticResource Caption}"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10">
                        <Button x:Name="StartButton" Content="▶  Start" Click="Start_Click" Margin="0" Padding="12,8"
                                FontWeight="SemiBold" IsEnabled="False"/>
                    </StackPanel>
                    <ListBox x:Name="AlgoList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             SelectionChanged="AlgoList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Info}" Foreground="#4B5563" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="#374151" TextWrapping="Wrap"
                       Text=""/>
        </Border>
    </Grid>
</Window>
